# Riverside Savings & Trust: safe-deposit vault registry.
# The vault serials and the guard codename were generated by Terraform and are
# intentionally NOT printed anywhere. Find them in the state.

locals {
  vaults = toset(["north-wing", "annex", "basement"])
}

resource "random_integer" "serial" {
  for_each = local.vaults
  min      = 100000
  max      = 999999
}

resource "random_pet" "night_guard" {
  length    = 2
  separator = "-"
  prefix    = "guard"
}

resource "local_file" "registry" {
  filename = "${path.module}/registry/vaults.txt"
  content = join("\n", concat(
    [for v in sort(keys(random_integer.serial)) : "vault ${v}: serial sealed in state"],
    ["night guard: sealed in state", ""]
  ))
}
